# Comprobacion corta de la misma configuracion de choque: 1152 atomos.
# No dura lo suficiente para desarrollar una onda de choque estacionaria.
cell vector 32.4 0 0 0 32.4 0 0 0 43.2
periodic true true true
input crystal3d type=fcc symbol=Ar nx=6 ny=6 nz=8

steps 100
set lastconfig smoke-final.dump
output xyz file=smoke.xyz level=1 precout=10 each=20
monitor step,potential-energy,kinetic-energy,total-energy,temperature,pressure,szz start=0 end=-1 each=20 output=smoke-monitor.dat

use lennardjones
    sigma 3.41
    epsilon 0.0103408
    cutoff 8.5
enduse

use velocityverlet
    dt 0.5
enduse

use linkedcell
    cutoff 8.5
    nx 3
    ny 3
    nz 4
    mode noauto
enduse

cellmanager linkedcell
potential lennardjones Ar Ar
integrator velocityverlet

prepare setvelocity velocity=<0,0,-0.004>
use setvelocity as toward_positive_z
    velocity <0,0,0.004>
enduse
set filter-at-end true
# El corte esta entre planos FCC z=21.6 y z=24.3: 576 atomos por mitad.
apply toward_positive_z start=0 end=0 each=1 over box x=all y=all z=0-22.95
