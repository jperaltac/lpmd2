# Comparacion manual de tiempos: mismo choque de 6912 atomos, 200 pasos.
# Unidades LPMD: angstrom, femtosegundo, eV; velocidad en angstrom/fs.
# Se omite XYZ en todos los casos; se conservan monitor y estado final.
cell vector 32.4 0 0 0 32.4 0 0 0 259.2
periodic true true true
input crystal3d type=fcc symbol=Ar nx=6 ny=6 nz=48

# 200 pasos x 0.5 fs = 100 fs, usados solo para comparar tiempos.
steps 200
set lastconfig tiempos-final.dump
monitor step,potential-energy,kinetic-energy,total-energy,temperature,pressure,szz start=0 end=-1 each=100 output=tiempos-monitor.dat

use lennardjones
    sigma 3.41
    epsilon 0.0103408
    cutoff 8.5
enduse

use velocityverlet
    dt 0.5
enduse

use linkedcell
    cutoff 8.5
    nx 3
    ny 3
    nz 24
    mode noauto
enduse

cellmanager linkedcell
potential lennardjones Ar Ar
integrator velocityverlet

prepare setvelocity velocity=<0,0,-0.004>
use setvelocity as toward_positive_z
    velocity <0,0,0.004>
enduse
set filter-at-end true
apply toward_positive_z start=0 end=0 each=1 over box x=all y=all z=0-130.95
