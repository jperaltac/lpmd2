prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: liblpmd
Description: An object-oriented, modular Molecular Dynamics library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -llpmd
Libs.private: -ldl -lm
Cflags: -I${includedir}
